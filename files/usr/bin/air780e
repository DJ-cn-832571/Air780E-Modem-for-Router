#!/usr/bin/python3
import json, socket, sys
action=sys.argv[1] if len(sys.argv)>1 else 'snapshot'
value={'action':'snapshot' if action=='status' else action}
if not sys.stdin.isatty() and action not in ('status','snapshot','diagnostics'):
    raw=sys.stdin.read(65537)
    if raw.strip(): value.update(json.loads(raw))
try:
    with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as client:
        client.settimeout(15)
        client.connect('/var/run/air780e/service.sock')
        client.sendall((json.dumps(value)+'\n').encode())
        with client.makefile('rb') as stream: result=json.loads(stream.readline(2097153))
    print(json.dumps(result,ensure_ascii=False,indent=2))
    sys.exit(0 if result.get('ok') else 1)
except Exception as error:
    print(json.dumps({'ok':False,'error':str(error)},ensure_ascii=False)); sys.exit(1)
